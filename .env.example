# ═══════════════════════════════════════════════════
# GCC Timesheet — Environment Configuration
# ═══════════════════════════════════════════════════
# Local backend: copy to server/.env. Docker Compose: copy to root .env.
# NEVER commit .env to git.

# ── Core Server ─────────────────────────────────────
NODE_ENV=development
PORT=3001

# One-time system-admin provisioning (only when no system admin exists).
# Set both before first startup; use a unique password of at least 12 characters.
# Remove these values after provisioning. No default account is created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional demo users for development only; never permitted in production.
SEED_DEMO_DATA=false

# ── JWT (local authentication) ───────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
# false for local HTTP; true when users access the app through HTTPS.
COOKIE_SECURE=false

# ── SQLite Database ──────────────────────────────────
DB_PATH=./data/timesheet.db

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

# ═══════════════════════════════════════════════════
# Microsoft 365 Integration (optional)
# Leave blank to run in local-only mode.
# ═══════════════════════════════════════════════════

# ── Microsoft Entra ID (for MSAL SSO login) ─────────
# Get these from Azure Portal → App registrations
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ── SharePoint (for data sync to SharePoint Lists) ──
# Full URL to your SharePoint site (no trailing slash)
SHAREPOINT_SITE_URL=
# Uses the same Entra app registration as above
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ── Power Automate (for approval workflow) ──────────
# Copy the HTTP POST URL from your Power Automate flow trigger
POWER_AUTOMATE_WEBHOOK_URL=
# A strong random secret shared between this app and the PA flow
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POWER_AUTOMATE_CALLBACK_SECRET=

# ── Application Base URL (for reverse proxies / external clients) ──
# e.g. http://localhost:3001 or https://gcc-timesheet.company.com
APP_BASE_URL=http://localhost:3001

# ── Power BI Read-Only REST API ─────────────────────
# Enable or disable Power BI reporting endpoints (default: true)
POWERBI_API_ENABLED=true
# Base path for Power BI reporting endpoints (default: /api/powerbi)
POWERBI_API_BASE_PATH=/api/powerbi
# Secure dedicated read-only API key for Power BI reporting
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POWERBI_API_KEY=
# Maximum records returned in a single reporting query without pagination (safety cap)
POWERBI_MAX_RECORDS=50000
# Server-side cache TTL in seconds (positive integer, default: 60).
# The current parser treats 0 as the default 60, so 0 does not disable caching.
POWERBI_CACHE_TTL=60

# ═══════════════════════════════════════════════════
# Feature Flags
# Set to true to enable each M365 integration.
# All default to false (local-only mode).
# ═══════════════════════════════════════════════════
ENABLE_MSAL_AUTH=false
ENABLE_SHAREPOINT_SYNC=false
ENABLE_POWER_AUTOMATE=false

# ═══════════════════════════════════════════════════
# GCC Timesheet — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Core Server ─────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── JWT (local authentication) ───────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ── SQLite Database ──────────────────────────────────
DB_PATH=./data/timesheet.db

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

# ═══════════════════════════════════════════════════
# Microsoft 365 Integration (optional)
# Leave blank to run in local-only mode.
# ═══════════════════════════════════════════════════

# ── Microsoft Entra ID (for MSAL SSO login) ─────────
# Get these from Azure Portal → App registrations
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here

# ── SharePoint (for data sync to SharePoint Lists) ──
# Full URL to your SharePoint site (no trailing slash)
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/GCCTimeSheet
# Uses the same Entra app registration as above
SHAREPOINT_CLIENT_ID=your-entra-client-id-here
SHAREPOINT_CLIENT_SECRET=your-entra-client-secret-here

# ── Power Automate (for approval workflow) ──────────
# Copy the HTTP POST URL from your Power Automate flow trigger
POWER_AUTOMATE_WEBHOOK_URL=https://prod-xx.eastus.logic.azure.com/workflows/REPLACE_ME/triggers/manual/paths/invoke
# A strong random secret shared between this app and the PA flow
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POWER_AUTOMATE_CALLBACK_SECRET=generate-a-strong-random-secret-here

# ── Power BI (for embedded reports) ─────────────────
# API key for the /api/powerbi/export endpoint
POWERBI_API_KEY=generate-a-strong-api-key-here

# ═══════════════════════════════════════════════════
# Feature Flags
# Set to true to enable each M365 integration.
# All default to false (local-only mode).
# ═══════════════════════════════════════════════════
ENABLE_MSAL_AUTH=false
ENABLE_SHAREPOINT_SYNC=false
ENABLE_POWER_AUTOMATE=false

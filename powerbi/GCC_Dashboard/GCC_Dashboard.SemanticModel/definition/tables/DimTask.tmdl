	partition DimTask = m
		mode: import
		source =
				let
				    Rows = fnApi("tasks"),
				    Raw = Table.FromRecords(Rows, {"id", "taskCategory", "classification", "estimatedHours", "inputReceivedDate", "startDate", "targetDate", "deliveredDate"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Raw, {{"id", Int64.Type}, {"taskCategory", type text}, {"classification", type text}, {"estimatedHours", type number}, {"inputReceivedDate", type date}, {"startDate", type date}, {"targetDate", type date}, {"deliveredDate", type date}}, "en-US"),
				    Checked = if List.Count(List.Distinct(Typed[id])) <> Table.RowCount(Typed) or List.Contains(Typed[id], null) then error "Duplicate or missing DimTask key." else Typed
				in Checked


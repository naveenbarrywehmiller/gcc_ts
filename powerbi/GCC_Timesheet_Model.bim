          },
          {
            "name": "Billable Hours",
            "expression": "CALCULATE([Total Hours], FactTimesheet[isBillable] = TRUE())",
            "formatString": "#,##0.0",
            "displayFolder": "03 Billing",
            "lineageTag": "50b211ac-7e66-4023-b9b3-dfa3de3066da",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Non-Billable Hours",
            "expression": "CALCULATE([Total Hours], FactTimesheet[isBillable] = FALSE())",
            "formatString": "#,##0.0",
            "displayFolder": "03 Billing",
            "lineageTag": "1fc560da-69bb-4aa4-84eb-6b86b4756b1a",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Billable Percentage",
            "expression": "DIVIDE([Billable Hours], [Total Hours], 0)",
            "formatString": "0.0%",
            "displayFolder": "03 Billing",
            "lineageTag": "c7e73f0f-204d-4c1b-808e-2ea156c3f4ce",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Submission Rate",
            "expression": "VAR SubmittedOrBeyond = CALCULATE([Total Entries], FactTimesheet[status] IN {\"submitted\", \"approved\", \"rejected\", \"recalled\"}) RETURN DIVIDE(SubmittedOrBeyond, [Total Entries], 0)",
            "formatString": "0.0%",
            "displayFolder": "04 Compliance",
            "lineageTag": "b6483b3f-7e68-4168-ac2a-5278e084b1b3",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Approval Rate",
            "expression": "VAR ApprovedOnly = CALCULATE([Total Entries], FactTimesheet[status] = \"approved\") VAR SubmittedOrBeyond = CALCULATE([Total Entries], FactTimesheet[status] IN {\"submitted\", \"approved\", \"rejected\", \"recalled\"}) RETURN DIVIDE(ApprovedOnly, SubmittedOrBeyond, 0)",
            "formatString": "0.0%",
            "displayFolder": "04 Compliance",
            "lineageTag": "86aafcc6-c7d0-4855-adb5-82e5282d311f",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Rejection Rate",
            "expression": "VAR RejectedOnly = CALCULATE([Total Entries], FactTimesheet[status] = \"rejected\") VAR SubmittedOrBeyond = CALCULATE([Total Entries], FactTimesheet[status] IN {\"submitted\", \"approved\", \"rejected\", \"recalled\"}) RETURN DIVIDE(RejectedOnly, SubmittedOrBeyond, 0)",
            "formatString": "0.0%",
            "displayFolder": "04 Compliance",
            "lineageTag": "024a39fb-89ff-4bea-86fe-f3d5d13d850c",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Working Days",
            "expression": "CALCULATE(DISTINCTCOUNT(DimDate[Date]), DimDate[IsWeekend] = FALSE(), DimDate[IsHoliday] = FALSE())",
            "formatString": "#,##0",
            "displayFolder": "05 Utilization",
            "lineageTag": "cfb98f47-d846-4893-a53d-cd1f0701f811",
            "dataType": "int64",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Standard Daily Hours",
            "expression": "8",
            "formatString": "#,##0.0",
            "displayFolder": "05 Utilization",
            "lineageTag": "5860cfca-bb6a-4836-9325-41f43085c889",
            "dataType": "int64",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Expected Hours",
            "expression": "[Working Days] * [Standard Daily Hours]",
            "formatString": "#,##0.0",
            "displayFolder": "05 Utilization",
            "lineageTag": "3d830a43-472a-4ad0-a59e-ea489135e55c",
            "dataType": "int64",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Utilization Rate",
            "expression": "DIVIDE([Total Hours], [Expected Hours], 0)",
            "formatString": "0.0%",
            "displayFolder": "05 Utilization",
            "lineageTag": "e0128d35-7536-4cc4-9539-e951a5195de2",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Weekend Hours",
            "expression": "CALCULATE([Total Hours], DimDate[IsWeekend] = TRUE())",
            "formatString": "#,##0.0",
            "displayFolder": "05 Utilization",
            "lineageTag": "513723dd-e41d-4aa3-a728-cf37380ebcd5",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Holiday Hours",
            "expression": "CALCULATE([Total Hours], DimDate[IsHoliday] = TRUE())",
            "formatString": "#,##0.0",
            "displayFolder": "05 Utilization",
            "lineageTag": "3b427bc5-659f-486f-8c8f-514a7aa52f21",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Current Month Hours",
            "expression": "CALCULATE([Total Hours], DATESMTD(DimDate[Date]))",
            "formatString": "#,##0.0",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "4fa1610e-0867-4cb0-9485-f320e7cdba2d",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Previous Month Hours",
            "expression": "CALCULATE([Total Hours], PREVIOUSMONTH(DimDate[Date]))",
            "formatString": "#,##0.0",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "e610929f-554a-46c7-a266-78bbf620efe3",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Month over Month Change",
            "expression": "[Current Month Hours] - [Previous Month Hours]",
            "formatString": "#,##0.0;(#,##0.0);-",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "7a819bec-fb90-418f-a351-3f6177fab4c4",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Month over Month Change %",
            "expression": "DIVIDE([Month over Month Change], ABS([Previous Month Hours]) + 0.0000001, 0)",
            "formatString": "0.0%;(0.0%);-",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "ce9e4b66-e5ba-4154-9ece-fde17252043e",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "YTD Hours",
            "expression": "CALCULATE([Total Hours], DATESYTD(DimDate[Date]))",
            "formatString": "#,##0.0",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "496bb962-fc9c-413f-b73f-4d6c9541fefa",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Previous Year YTD",
            "expression": "CALCULATE([Total Hours], DATESYTD(SAMEPERIODLASTYEAR(DimDate[Date])))",
            "formatString": "#,##0.0",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "f41263cd-39a7-4728-a25f-427bc28752b6",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "YTD Variance",
            "expression": "[YTD Hours] - [Previous Year YTD]",
            "formatString": "#,##0.0;(#,##0.0);-",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "47d4d52c-3c12-464a-9f20-3a6d3c492269",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "YTD Variance %",
            "expression": "DIVIDE([YTD Variance], ABS([Previous Year YTD]) + 0.0000001, 0)",
            "formatString": "0.0%;(0.0%);-",
            "displayFolder": "06 Time Intelligence",
            "lineageTag": "66c7b43e-7864-48dd-9b48-15833ab3ca6c",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Average Daily Hours",
            "expression": "DIVIDE([Total Hours], DISTINCTCOUNT(FactTimesheet[date]), 0)",
            "formatString": "#,##0.0",
            "displayFolder": "07 Averages",
            "lineageTag": "84396f65-84b7-425a-bd61-55992a811a50",
            "dataType": "double",
            "modifiedTime": "2026-09-27T15:48:18.686667",
            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Average Weekly Hours",
            "expression": "DIVIDE([Total Hours], DISTINCTCOUNT(FactTimesheet[week]), 0)",

            "structureModifiedTime": "2026-09-27T15:48:18.653333"
          },
          {
            "name": "Invalid Hours Count",
            "expression": "CALCULATE(COUNTROWS(FactTimesheet), OR(FactTimesheet[hours] < 0, FactTimesheet[hours] > 24))",
            "formatString": "#,##0",

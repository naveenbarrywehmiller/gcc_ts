            "source": {
              "type": "m",
              "expression": "let\n    Source = Json.Document(Web.Contents(\"http://localhost:3001/api/powerbi/holidays\", [Headers=[#\"X-API-Key\"=\"YOUR_API_KEY_HERE\", #\"Accept\"=\"application/json\"]])),\n    Data = if Record.HasFields(Source, \"data\") then Source[data] else {},\n    Rows = Table.FromRecords(Data, {\"id\",\"date\",\"holidayName\",\"createdDate\"}, MissingField.UseNull)\nin\n    Rows"
            }
          }
        ]
      },

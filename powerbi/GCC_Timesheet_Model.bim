        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "state": "ready",
            "modifiedTime": "2026-09-27T15:51:26.573333",
            "refreshedTime": "2026-09-27T15:51:26.573333",
            "source": {
              "type": "calculated",
              "expression": "VAR StartDate = DATE(2020, 1, 1)\nVAR EndDate = DATE(2035, 12, 31)\nRETURN\nADDCOLUMNS(CALENDAR(StartDate, EndDate), \"Year\", YEAR([Date]), \"QuarterNumber\", ROUNDUP(MONTH([Date]) / 3, 0), \"Quarter\", \"Q\" & FORMAT(ROUNDUP(MONTH([Date]) / 3, 0), \"0\"), \"Month\", MONTH([Date]), \"MonthName\", FORMAT([Date], \"MMMM\"), \"MonthShort\", FORMAT([Date], \"MMM\"), \"WeekNumber\", WEEKNUM([Date], 2), \"WeekStart\", [Date] - WEEKDAY([Date], 2) + 1, \"DayOfMonth\", DAY([Date]), \"DayOfWeek\", WEEKDAY([Date], 2), \"DayName\", FORMAT([Date], \"dddd\"), \"IsWeekend\", WEEKDAY([Date], 2) >= 6, \"IsHoliday\", CONTAINS(DimHoliday, DimHoliday[date], [Date]), \"YearMonth\", FORMAT([Date], \"YYYY-MM\"), \"YearQuarter\", FORMAT([Date], \"YYYY\") & \" Q\" & FORMAT(ROUNDUP(MONTH([Date]) / 3, 0), \"0\"), \"MonthYearLabel\", FORMAT([Date], \"MMM YYYY\"), \"WeekLabel\", \"W\" & FORMAT(WEEKNUM([Date], 2), \"00\") & \" \" & FORMAT([Date], \"YYYY\"))"
            }
          }
        ]
      },

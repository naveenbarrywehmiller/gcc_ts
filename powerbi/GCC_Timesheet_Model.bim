              "type": "m",
              "expression": "let\n    Source = Json.Document(Web.Contents(\"http://localhost:3001/api/powerbi/timesheets?limit=1000\", [Headers=[#\"X-API-Key\"=\"YOUR_API_KEY_HERE\", #\"Accept\"=\"application/json\"]])),\n    Data = if Record.HasFields(Source, \"data\") then Source[data] else {},\n    Rows = Table.FromRecords(Data, {\"id\",\"employeeId\",\"employeeName\",\"email\",\"division\",\"department\",\"admin\",\"date\",\"week\",\"weekYear\",\"project\",\"projectCode\",\"projectCategory\",\"taskClassification\",\"hours\",\"status\",\"isBillable\",\"submissionDate\",\"approvalDate\",\"createdDate\",\"updatedDate\"}, MissingField.UseNull)\nin\n    Rows"

/// GCC Timesheet enterprise measure table.
table _Measures
	lineageTag: 2bb830ec-4f5d-4361-b48f-760c4eacb8ad

	measure 'Total Entries' = COUNTROWS(FactTimesheet)
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: facad5fb-f369-4c44-935f-695c415b2978

	measure 'Total Hours' = SUM(FactTimesheet[hours])
		formatString: #,##0.0
		displayFolder: 01 Executive
		lineageTag: d7819c3b-ec64-4f6e-b903-d3d9f0041344

	measure 'Average Hours per Employee' = DIVIDE([Total Hours], [Active Employee Count], 0)
		formatString: #,##0.0
		displayFolder: 01 Executive
		lineageTag: 64fdbf85-c30a-4f33-b7b0-a33d641b7d64

	measure 'Active Employee Count' = CALCULATE(DISTINCTCOUNT(DimEmployee[employeeId]), DimEmployee[isActive] = TRUE())
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 7b272ca0-0ee4-4794-a78a-f4afa5695758

	measure 'Active Project Count' = CALCULATE(DISTINCTCOUNT(DimProject[projectCode]), DimProject[isActive] = TRUE())
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 5447999d-f644-491f-8136-8af160fc563e

	measure 'Division Count' = DISTINCTCOUNT(DimDivision[divisionName])
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: 4087f484-9928-4f39-9bfb-5024ec787b1e

	measure 'Department Count' = DISTINCTCOUNT(DimDepartment[departmentName])
		formatString: #,##0
		displayFolder: 01 Executive
		lineageTag: f20a30a2-f7bc-4aa5-b214-acd4e437a819

	measure 'Draft Hours' = CALCULATE([Total Hours], FactTimesheet[status] = "draft")
		formatString: #,##0.0
		displayFolder: 02 Status
		lineageTag: bd7b8d2f-d00f-47a8-a552-996ed607244a

	measure 'Submitted Hours' = CALCULATE([Total Hours], FactTimesheet[status] = "submitted")
		formatString: #,##0.0
		displayFolder: 02 Status
		lineageTag: 3d4dfed5-ed03-4f98-ac46-5f149cbc3668

	measure 'Approved Hours' = CALCULATE([Total Hours], FactTimesheet[status] = "approved")
		formatString: #,##0.0
		displayFolder: 02 Status
		lineageTag: 0f720de2-15d9-46ee-a0f3-c709fee86f56

	measure 'Rejected Hours' = CALCULATE([Total Hours], FactTimesheet[status] = "rejected")
		formatString: #,##0.0
		displayFolder: 02 Status
		lineageTag: 052bcff9-6c44-49c6-ac2f-f24c3c6c453a

	measure 'Pending Hours' = CALCULATE([Total Hours], FactTimesheet[status] IN {"draft", "submitted"})
		formatString: #,##0.0
		displayFolder: 02 Status
		lineageTag: 8fde07c0-6a3b-4074-b428-af461535cb0a

	measure 'Billable Hours' = CALCULATE([Total Hours], FactTimesheet[isBillable] = TRUE())
		formatString: #,##0.0
		displayFolder: 03 Billing
		lineageTag: 50b211ac-7e66-4023-b9b3-dfa3de3066da

	measure 'Non-Billable Hours' = CALCULATE([Total Hours], FactTimesheet[isBillable] = FALSE())
		formatString: #,##0.0
		displayFolder: 03 Billing
		lineageTag: 1fc560da-69bb-4aa4-84eb-6b86b4756b1a

	measure 'Billable Percentage' = DIVIDE([Billable Hours], [Total Hours], 0)
		formatString: 0.0%
		displayFolder: 03 Billing
		lineageTag: c7e73f0f-204d-4c1b-808e-2ea156c3f4ce

	measure 'Submission Rate' = VAR SubmittedOrBeyond = CALCULATE([Total Entries], FactTimesheet[status] IN {"submitted", "approved", "rejected", "recalled"}) RETURN DIVIDE(SubmittedOrBeyond, [Total Entries], 0)
		formatString: 0.0%
		displayFolder: 04 Compliance
		lineageTag: b6483b3f-7e68-4168-ac2a-5278e084b1b3

	measure 'Approval Rate' = VAR ApprovedOnly = CALCULATE([Total Entries], FactTimesheet[status] = "approved") VAR SubmittedOrBeyond = CALCULATE([Total Entries], FactTimesheet[status] IN {"submitted", "approved", "rejected", "recalled"}) RETURN DIVIDE(ApprovedOnly, SubmittedOrBeyond, 0)
		formatString: 0.0%
		displayFolder: 04 Compliance
		lineageTag: 86aafcc6-c7d0-4855-adb5-82e5282d311f

	measure 'Rejection Rate' = VAR RejectedOnly = CALCULATE([Total Entries], FactTimesheet[status] = "rejected") VAR SubmittedOrBeyond = CALCULATE([Total Entries], FactTimesheet[status] IN {"submitted", "approved", "rejected", "recalled"}) RETURN DIVIDE(RejectedOnly, SubmittedOrBeyond, 0)
		formatString: 0.0%
		displayFolder: 04 Compliance
		lineageTag: 024a39fb-89ff-4bea-86fe-f3d5d13d850c

	measure 'Working Days' = CALCULATE(DISTINCTCOUNT(DimDate[Date]), DimDate[IsWeekend] = FALSE(), DimDate[IsHoliday] = FALSE())
		formatString: #,##0
		displayFolder: 05 Utilization
		lineageTag: cfb98f47-d846-4893-a53d-cd1f0701f811

	measure 'Standard Daily Hours' = 8
		formatString: #,##0.0
		displayFolder: 05 Utilization
		lineageTag: 5860cfca-bb6a-4836-9325-41f43085c889

	measure 'Expected Hours' = [Working Days] * [Standard Daily Hours]
		formatString: #,##0.0
		displayFolder: 05 Utilization
		lineageTag: 3d830a43-472a-4ad0-a59e-ea489135e55c

	measure 'Utilization Rate' = DIVIDE([Total Hours], [Expected Hours], 0)
		formatString: 0.0%
		displayFolder: 05 Utilization
		lineageTag: e0128d35-7536-4cc4-9539-e951a5195de2

	measure 'Weekend Hours' = CALCULATE([Total Hours], DimDate[IsWeekend] = TRUE())
		formatString: #,##0.0
		displayFolder: 05 Utilization
		lineageTag: 513723dd-e41d-4aa3-a728-cf37380ebcd5

	measure 'Holiday Hours' = CALCULATE([Total Hours], DimDate[IsHoliday] = TRUE())
		formatString: #,##0.0
		displayFolder: 05 Utilization
		lineageTag: 3b427bc5-659f-486f-8c8f-514a7aa52f21

	measure 'Current Month Hours' = CALCULATE([Total Hours], DATESMTD(DimDate[Date]))
		formatString: #,##0.0
		displayFolder: 06 Time Intelligence
		lineageTag: 4fa1610e-0867-4cb0-9485-f320e7cdba2d

	measure 'Previous Month Hours' = CALCULATE([Total Hours], PREVIOUSMONTH(DimDate[Date]))
		formatString: #,##0.0
		displayFolder: 06 Time Intelligence
		lineageTag: e610929f-554a-46c7-a266-78bbf620efe3

	measure 'Month over Month Change' = [Current Month Hours] - [Previous Month Hours]
		formatString: #,##0.0;(#,##0.0);-
		displayFolder: 06 Time Intelligence
		lineageTag: 7a819bec-fb90-418f-a351-3f6177fab4c4

	measure 'Month over Month Change %' = DIVIDE([Month over Month Change], ABS([Previous Month Hours]) + 0.0000001, 0)
		formatString: 0.0%;(0.0%);-
		displayFolder: 06 Time Intelligence
		lineageTag: ce9e4b66-e5ba-4154-9ece-fde17252043e

	measure 'YTD Hours' = CALCULATE([Total Hours], DATESYTD(DimDate[Date]))
		formatString: #,##0.0
		displayFolder: 06 Time Intelligence
		lineageTag: 496bb962-fc9c-413f-b73f-4d6c9541fefa

	measure 'Previous Year YTD' = CALCULATE([Total Hours], DATESYTD(SAMEPERIODLASTYEAR(DimDate[Date])))
		formatString: #,##0.0
		displayFolder: 06 Time Intelligence
		lineageTag: f41263cd-39a7-4728-a25f-427bc28752b6

	measure 'YTD Variance' = [YTD Hours] - [Previous Year YTD]
		formatString: #,##0.0;(#,##0.0);-
		displayFolder: 06 Time Intelligence
		lineageTag: 47d4d52c-3c12-464a-9f20-3a6d3c492269

	measure 'YTD Variance %' = DIVIDE([YTD Variance], ABS([Previous Year YTD]) + 0.0000001, 0)
		formatString: 0.0%;(0.0%);-
		displayFolder: 06 Time Intelligence
		lineageTag: 66c7b43e-7864-48dd-9b48-15833ab3ca6c

	measure 'Average Daily Hours' = DIVIDE([Total Hours], DISTINCTCOUNT(FactTimesheet[date]), 0)
		formatString: #,##0.0
		displayFolder: 07 Averages
		lineageTag: 84396f65-84b7-425a-bd61-55992a811a50

	measure 'Average Weekly Hours' = DIVIDE([Total Hours], DISTINCTCOUNT(FactTimesheet[week]), 0)
		formatString: #,##0.0
		displayFolder: 07 Averages
		lineageTag: a1e37634-d0e4-47d3-bdfa-a7e30c3c6f42

	measure 'Invalid Hours Count' = CALCULATE(COUNTROWS(FactTimesheet), OR(FactTimesheet[hours] < 0, FactTimesheet[hours] > 24))
		formatString: #,##0
		displayFolder: 08 Data Quality
		lineageTag: 9678830d-867f-4797-b1b0-5f3031184e89

	measure 'Missing Employee IDs' = CALCULATE(COUNTROWS(FactTimesheet), ISBLANK(FactTimesheet[employeeId]))
		formatString: #,##0
		displayFolder: 08 Data Quality
		lineageTag: bab0b43f-2a05-4cb8-b63b-aa146d2009f1

	measure 'Invalid Status Count' = CALCULATE(COUNTROWS(FactTimesheet), NOT(FactTimesheet[status] IN {"draft", "submitted", "approved", "rejected", "recalled"}))
		formatString: #,##0
		displayFolder: 08 Data Quality
		lineageTag: 72979b85-a627-4a49-8d32-e0d7eba02387

	measure 'Last Data Refresh' = NOW()
		formatString: General Date
		displayFolder: 09 Metadata
		lineageTag: d6482cc9-540f-48f0-a13f-9841abed2fe2

	column 'Measure Group'
		isNameInferred
		sourceColumn: [Measure Group]

	partition _Measures = calculated
		mode: import
		source = DATATABLE("Measure Group", STRING, {{"GCC Timesheet Measures"}})

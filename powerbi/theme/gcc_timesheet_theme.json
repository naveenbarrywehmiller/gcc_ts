{
  "name": "GCC Timesheet",
  "dataColors": [
    "#2563EB",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#8B5CF6",
    "#EC4899",
    "#06B6D4",
    "#84CC16",
    "#F97316",
    "#6366F1",
    "#14B8A6",
    "#E11D48"
  ],
  "background": "#F8FAFC",
  "foreground": "#1E293B",
  "tableAccent": "#2563EB",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#2563EB",
  "center": "#F59E0B",
  "minimum": "#EF4444",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#334155"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": "#FFFFFF",
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": "#E2E8F0",
            "show": true
          }
        ],
        "title": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": "#1E293B",
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": "#F1F5F9",
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "categoryLabel": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "color": "#64748B"
          }
        ],
        "labels": [
          {
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "color": "#1E293B"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "fontColor": "#334155",
            "background": "#F8FAFC"
          }
        ],
        "header": [
          {
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": "#1E293B"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridHorizontal": true,
            "gridVerticalColor": "#E2E8F0",
            "gridHorizontalColor": "#E2E8F0",
            "gridVerticalWeight": 1,
            "gridHorizontalWeight": 1,
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": "#FFFFFF",
            "backColor": "#2563EB"
          }
        ],
        "values": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "fontColor": "#334155",
            "backColor": "#FFFFFF"
          }
        ],
        "total": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": "#1E293B",
            "backColor": "#F1F5F9"
          }
        ]
      }
    }
  }
}

		summarizeBy: none
		sourceColumn: projectId

	column taskId
		dataType: int64
		lineageTag: 58bb1e92-c7f4-5023-a2d6-48e29b8c919c
		summarizeBy: none
		sourceColumn: taskId

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd

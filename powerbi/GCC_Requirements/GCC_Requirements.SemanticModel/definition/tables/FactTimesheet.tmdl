		lineageTag: 33087f64-39cb-5be7-ae86-98ddf0d6e7e2
		summarizeBy: none
		sourceColumn: id

	column userId
		dataType: int64
		lineageTag: 6f8c3ba3-71ec-556d-b402-218e672aafa4
		summarizeBy: none
		sourceColumn: userId

	column projectId

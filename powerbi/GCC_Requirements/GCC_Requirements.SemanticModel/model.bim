        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Today=Date.From(RefreshClock),\n    Dates=List.RemoveNulls(List.Combine({FactTimesheet[date],DimProject[startDate],DimProject[targetDate],DimProject[deliveredDate],FactStaffing[date],FactVacation[date],{Date.AddYears(Today,-1),Date.AddYears(Today,1)}})),\n    Start=Date.StartOfYear(List.Min(Dates)), End=Date.EndOfYear(List.Max(Dates)),\n    Source=Table.FromList(List.Dates(Start,Duration.Days(End-Start)+1,#duration(1,0,0,0)),Splitter.SplitByNothing(),{\"Date\"}),\n    Typed=Table.TransformColumnTypes(Source,{{\"Date\",type date}}),\n    Y=Table.AddColumn(Typed,\"Year\",each Date.Year([Date]),Int64.Type),\n    M=Table.AddColumn(Y,\"Month\",each Date.ToText([Date],\"MMM\",\"en-US\"),type text),\n    MN=Table.AddColumn(M,\"MonthNumber\",each Date.Month([Date]),Int64.Type),\n    YM=Table.AddColumn(MN,\"YearMonth\",each Date.ToText([Date],\"yyyy-MM\"),type text),\n    W=Table.AddColumn(YM,\"WeekStart\",each Date.StartOfWeek([Date],Day.Monday),type date),\n    FY=Table.AddColumn(W,\"FiscalYear\",each \"FY \" & Text.From(Date.Year(Date.AddMonths([Date],1-FiscalStartMonth))),type text),\n    WD=Table.AddColumn(FY,\"IsWeekday\",each Date.DayOfWeek([Date],Day.Monday)<5,type logical),\n    H=Table.AddColumn(WD,\"IsHoliday\",each List.Contains(DimHoliday[date],[Date]),type logical)\nin H"
            }
          }
        ],
        "annotations": [
          {
            "name": "__PBI_LocalDateTable",
            "value": "false"
          }
        ]
      },

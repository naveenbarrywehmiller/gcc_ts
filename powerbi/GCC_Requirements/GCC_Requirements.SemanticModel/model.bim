            "summarizeBy": "none",
            "lineageTag": "da626b8f-34e2-5577-ad68-c7a4767a00f9"
          },
          {
            "name": "remainingForecastHours",
            "dataType": "double",
            "sourceColumn": "remainingForecastHours",
            "summarizeBy": "none",
            "lineageTag": "17d0f45d-b5b3-5934-9a47-b53fa126a6f6"
          }
        ],
        "partitions": [
          {
            "name": "FactPlan",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Today=Date.From(RefreshClock),\n    Actuals=Table.Group(Table.SelectRows(FactTimesheet,each List.Contains({\"approved\",\"submitted\"},[status]) and [date]<Today),{\"projectId\"},{{\"Actual\",each List.Sum([hours]),type number}}),\n    Joined=Table.NestedJoin(DimProject,{\"id\"},Actuals,{\"projectId\"},\"Actuals\",JoinKind.LeftOuter),\n    Expanded=Table.ExpandTableColumn(Joined,\"Actuals\",{\"Actual\"}),\n    Valid=Table.SelectRows(Expanded,each [startDate]<>null and [targetDate]<>null and [targetDate]>=[startDate] and [budgetHours]<>null),\n    Daily=Table.AddColumn(Valid,\"Days\",each let\n        P=_, Days=List.Select(List.Dates(P[startDate],Duration.Days(P[targetDate]-P[startDate])+1,#duration(1,0,0,0)),each Date.DayOfWeek(_,Day.Monday)<5 and not List.Contains(DimHoliday[date],_)),\n        Future=List.Select(Days,each _>=Today),\n        Remaining=if P[projectStatus]=\"Inprogress\" then List.Max({0,P[budgetHours]-(P[Actual] ?? 0)}) else 0\n        in List.Transform(Days,each [projectId=P[id],date=_,scheduledHours=P[budgetHours]/List.Count(Days),\n            remainingForecastHours=if _>=Today and List.Count(Future)>0 then Remaining/List.Count(Future) else 0])),\n    Records=List.Combine(Daily[Days]),\n    T=Table.FromRecords(Records,{\"projectId\",\"date\",\"scheduledHours\",\"remainingForecastHours\"},MissingField.UseNull),\n    Typed=Table.TransformColumnTypes(T,{{\"projectId\",Int64.Type},{\"date\",type date},{\"scheduledHours\",type number},{\"remainingForecastHours\",type number}})\nin Typed"
            }
          }
        ]
      },
      {
        "name": "InputStatus",
        "description": "",
        "isHidden": false,
        "lineageTag": "3cf3bbb1-3a0c-50cc-9e5a-1c46f9055b5e",
        "columns": [
          {
            "name": "Requirement",
            "dataType": "string",
            "sourceColumn": "Requirement",
            "summarizeBy": "none",
            "lineageTag": "89c8f0ca-9c32-53be-9dc2-aaf71392ed62"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none",
            "lineageTag": "89ba92b3-f968-5446-a732-775e71161992"
          },
          {
            "name": "Definition",
            "dataType": "string",
            "sourceColumn": "Definition",
            "summarizeBy": "none",
            "lineageTag": "ca336b53-c8f1-5e4a-abf8-279904601d56"
          }
        ],
        "partitions": [
          {
            "name": "InputStatus",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Requirement=text,Status=text,Definition=text], {{\"Monthly utilization\",\"Available with assumptions\",\"Submitted + approved work; training/internal/admin/leave/holiday excluded. Current active roster capacity, Mon\\u2013Fri. Unmapped task categories block result.\"},{\"Yearly utilization from project start\",\"Needs allocation history\",\"Roster FY utilization is provided separately. Exact project-start utilization needs employee project allocations and employment start/end dates.\"},{\"Defect density / FTR / F I R\",\"Needs deliverable register\",\"FactDeliverable requires unique IDs, delivered dates, error counts and rework flags. Weekly error counts are available separately.\"},{\"Effort / schedule / on-time\",\"Available at project grain\",\"Budget vs project lifetime actuals for projects delivered in selected dates. Project delivery is not treated as a deliverable count.\"},{\"Team strength / dedicated / flex\",\"Available\",\"Current active roster and distinct contributing employees are separate. Employee supportingCategory defines Dedicated/Flex.\"},{\"Vacation / holidays / capacity\",\"Available with assumptions\",\"Historical recorded leave; future planned vacation. Capacity is a current-roster estimate, not historical contracted capacity.\"},{\"Training / internal / admin hours\",\"Available\",\"Explicit HourCategoryMap. Edit mappings to match production task categories; do not infer from billable flag.\"},{\"Forecast / scheduled hours\",\"Available as estimate\",\"Budget spread evenly across working dates. No resource assignment exists; department-specific demand is blank.\"},{\"Products touched\",\"Available\",\"Distinct project products with submitted/approved work in selected dates; blank products excluded.\"},{\"Improvement / designed / developed\",\"Available at weekly grain\",\"Deduplicated weekly row details, attributed to Monday. Conflicting copies block counts.\"},{\"VAVE / Automation / COE / cost / additive\",\"Needs improvement register\",\"FactImprovement is an empty typed source contract; no fabricated classification or counts.\"},{\"Open positions / new joiners\",\"Available\",\"Read-only staffing endpoint. Open positions at last selected month, joiners summed over selected months. Null stays unknown.\"},{\"Schedule alert \\u00b13%\",\"Provisional definition\",\"Schedule days divided by planned project duration. Workbook mixes days and percent; definition needs owner confirmation.\"},{\"Defect alert \\u00b15%\",\"Provisional target\",\"DefectTarget defaults to 0; red at >5 percentage points away. Confirm target and whether tolerance means relative percent.\"},{\"Platform / cohorts\",\"Needs business mapping\",\"Division is available; no separate platform master or cohort definition exists. Do not silently rename division as platform.\"}})"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "description": "",
        "isHidden": false,
        "lineageTag": "5f5fbd7b-b4e7-5fbb-8753-fb3e7461631a",
        "columns": [
          {
            "name": "Label",
            "dataType": "string",
            "sourceColumn": "Label",
            "summarizeBy": "none",
            "lineageTag": "9e220a7a-ae61-5b0d-bd5c-5578c38d0bcd",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Label=text],{{\"GCC requirements\"}})"
            }
          }
        ],
        "measures": [
          {
            "name": "Raw Hours",
            "expression": "CALCULATE(SUM(FactTimesheet[hours]), KEEPFILTERS(FILTER(ALL(FactTimesheet[division]),NOT ISCROSSFILTERED(DimDivision) || FactTimesheet[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "01 Overview",
            "formatString": "#,##0.0",
            "description": "All statuses including drafts/rejected. Use Actual Hours for reported work.",
            "lineageTag": "6b10930a-3369-5457-b8e7-d7b4ca287fa1"
          },
          {
            "name": "Actual Hours",
            "expression": "CALCULATE([Raw Hours], KEEPFILTERS(FactTimesheet[status] IN {\"submitted\", \"approved\"}))",
            "displayFolder": "01 Overview",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "f560a2a4-70b4-5879-b71d-8bf8d0716260"
          },
          {
            "name": "Approved Hours",
            "expression": "CALCULATE([Raw Hours], KEEPFILTERS(FactTimesheet[status] = \"approved\"))",
            "displayFolder": "01 Overview",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "eb0056f8-70ae-5108-8fbd-79d512b668f4"
          },
          {
            "name": "Contributing Employees",
            "expression": "CALCULATE(DISTINCTCOUNT(FactTimesheet[userId]), KEEPFILTERS(FactTimesheet[status] IN {\"submitted\",\"approved\"}),KEEPFILTERS(FILTER(ALL(FactTimesheet[division]),NOT ISCROSSFILTERED(DimDivision) || FactTimesheet[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "01 Overview",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "102a7b8a-ca1c-56fa-92d0-e4f28dfeb874"
          },
          {
            "name": "Active Team Strength",
            "expression": "CALCULATE(COUNTROWS(DimEmployee), KEEPFILTERS(DimEmployee[isActive] = TRUE()), KEEPFILTERS(DimEmployee[role] <> \"system admin\"), KEEPFILTERS(FILTER(ALL(DimEmployee[division]),NOT ISCROSSFILTERED(DimDivision) || DimEmployee[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "01 Overview",
            "formatString": "#,##0",
            "description": "Current roster; does not change with date or project selection.",
            "lineageTag": "8ff0b004-b0ed-5765-b2cb-b8b9aa312661"
          },
          {
            "name": "Training Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FactTimesheet[hourCategory]=\"Training\"))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "f706ea5a-0951-50c1-9c55-d9b8b5689c1d"
          },
          {
            "name": "Internal Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FactTimesheet[hourCategory]=\"Internal\"))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "61c68422-2018-58b0-b331-ef626be89a09"
          },
          {
            "name": "Admin Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FactTimesheet[hourCategory]=\"Admin\"))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "16a8368f-814d-5edf-9683-46ce4477035c"
          },
          {
            "name": "Vacation Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FactTimesheet[hourCategory]=\"Vacation\"))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "35405a06-7feb-5962-a3f0-8a1807774264"
          },
          {
            "name": "Holiday Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FactTimesheet[hourCategory]=\"Holiday\"))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "f5f3125c-a45d-5b92-a903-b1b0cb30d9a3"
          },
          {
            "name": "Productive Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FactTimesheet[hourCategory]=\"Productive\"))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "351e6010-77a6-514d-a2d6-b74c870adc7d"
          },
          {
            "name": "Unmapped Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FactTimesheet[hourCategory]=\"Unmapped\"))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "05be4a19-96d8-57fb-ae11-c5431e3189e5"
          },
          {
            "name": "Effective Hours",
            "expression": "IF(COALESCE([Unmapped Hours],0)=0,[Actual Hours]-COALESCE([Training Hours],0)-COALESCE([Internal Hours],0)-COALESCE([Admin Hours],0)-COALESCE([Vacation Hours],0)-COALESCE([Holiday Hours],0))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "e04cd92d-11bb-5f0c-b27b-76574fcebe89"
          },
          {
            "name": "Working Days",
            "expression": "COALESCE(CALCULATE(COUNTROWS(DimDate),KEEPFILTERS(DimDate[IsWeekday]=TRUE()),KEEPFILTERS(DimDate[IsHoliday]=FALSE())),0)",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "033b294f-12aa-5729-85e7-0a12ce7e57e8"
          },
          {
            "name": "Holiday Days",
            "expression": "CALCULATE(COUNTROWS(DimDate),KEEPFILTERS(DimDate[IsWeekday]=TRUE()),KEEPFILTERS(DimDate[IsHoliday]=TRUE()))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "15032cb3-e0ad-5ed4-b600-04a33de136e3"
          },
          {
            "name": "Roster Capacity Hours",
            "expression": "IF(NOT ISCROSSFILTERED(DimProject) && NOT ISCROSSFILTERED(DimTask), [Working Days]*SELECTEDVALUE(Settings[DailyHours],8)*[Active Team Strength])",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "Current roster estimate. Blank at project/task grain because allocations are unavailable.",
            "lineageTag": "60f159a7-ce60-5bbf-9fd3-9760ef326d62"
          },
          {
            "name": "Capacity Vacation Hours",
            "expression": "VAR H=SELECTEDVALUE(Settings[DailyHours],8)\nVAR A=MAX(Settings[AsOfDate])\nVAR People=CALCULATETABLE(VALUES(DimEmployee[id]),KEEPFILTERS(DimEmployee[isActive]=TRUE()),KEEPFILTERS(DimEmployee[role]<>\"system admin\"),KEEPFILTERS(FILTER(ALL(DimEmployee[division]),NOT ISCROSSFILTERED(DimDivision) || DimEmployee[division] IN VALUES(DimDivision[divisionName]))))\nVAR Days=CALCULATETABLE(VALUES(DimDate[Date]),KEEPFILTERS(DimDate[IsWeekday]=TRUE()),KEEPFILTERS(DimDate[IsHoliday]=FALSE()))\nRETURN IF(NOT ISCROSSFILTERED(DimProject) && NOT ISCROSSFILTERED(DimTask),SUMX(CROSSJOIN(People,Days),\nVAR D=DimDate[Date]\nVAR Recorded=CALCULATE(SUM(FactTimesheet[hours]),FactTimesheet[hourCategory]=\"Vacation\",FactTimesheet[status] IN {\"submitted\",\"approved\"})\nVAR Planned=CALCULATE(COUNTROWS(FactVacation))\nRETURN MIN(H,IF(D>=A && Planned>0,H,COALESCE(Recorded,0)))))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "Per employee/day capped at daily hours. Future plans supersede recorded leave, preventing double subtraction. Only weekdays excluding holidays.",
            "lineageTag": "09c697c9-ffb5-5912-aaf7-c06bd70cfd7b"
          },
          {
            "name": "Vacation Days",
            "expression": "DIVIDE([Capacity Vacation Hours],SELECTEDVALUE(Settings[DailyHours],8))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "2639e998-0754-5a5c-8b94-48152e2bce8c"
          },
          {
            "name": "Available Hours",
            "expression": "IF(NOT ISBLANK([Roster Capacity Hours]),MAX(0,[Roster Capacity Hours]-COALESCE([Capacity Vacation Hours],0)))",
            "displayFolder": "02 Utilization",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "ba6141fe-866c-5987-993d-b82e44532ff6"
          },
          {
            "name": "Monthly Utilization %",
            "expression": "DIVIDE([Effective Hours],[Available Hours])",
            "displayFolder": "02 Utilization",
            "formatString": "0.0%",
            "description": "Selected-period utilization using current roster estimate; monthly when grouped/filtered by YearMonth.",
            "lineageTag": "da295a52-d2bc-542c-a6de-7963367604ae"
          },
          {
            "name": "Under Utilized %",
            "expression": "IF(NOT ISBLANK([Monthly Utilization %]),1-[Monthly Utilization %])",
            "displayFolder": "02 Utilization",
            "formatString": "0.0%",
            "description": "",
            "lineageTag": "0fb4712a-ab92-55d9-9be8-014ff6ab3ce2"
          },
          {
            "name": "As Of Date",
            "expression": "MAX(Settings[AsOfDate])",
            "displayFolder": "09 Metadata",
            "formatString": "yyyy-mm-dd",
            "description": "",
            "lineageTag": "105a9762-cd0e-5046-aab7-026cd871c17c"
          },
          {
            "name": "Last Completed Friday",
            "expression": "[As Of Date]-MOD(WEEKDAY([As Of Date],2)-5+6,7)-1",
            "displayFolder": "09 Metadata",
            "formatString": "yyyy-mm-dd",
            "description": "",
            "lineageTag": "a70f4785-5a72-5b2a-b6f6-bc6c0f76fdaf"
          },
          {
            "name": "FY Utilization Through Friday %",
            "expression": "VAR E=[Last Completed Friday]\nVAR FM=SELECTEDVALUE(Settings[FiscalStartMonth],1)\nVAR S=DATE(YEAR(E)-IF(MONTH(E)<FM,1,0),FM,1)\nRETURN CALCULATE(IF(COALESCE([Unmapped Hours],0)=0,DIVIDE([Actual Hours]-COALESCE([Training Hours],0)-COALESCE([Vacation Hours],0)-COALESCE([Holiday Hours],0),[Available Hours])),REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],S,E))",
            "displayFolder": "02 Utilization",
            "formatString": "0.0%",
            "description": "Workbook annual numerator excludes training but retains internal/admin. Current-roster FY estimate; exact project-start denominator needs allocation history.",
            "lineageTag": "9e323750-80da-5987-861e-976e540273b7"
          },
          {
            "name": "Available Hours Last Week",
            "expression": "VAR S=[As Of Date]-WEEKDAY([As Of Date],2)+1+(-7) RETURN CALCULATE([Available Hours],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],S,S+6))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "a22eb53c-d3e2-51b3-82ed-7e8e3e93e3a1"
          },
          {
            "name": "Available Hours Current Week",
            "expression": "VAR S=[As Of Date]-WEEKDAY([As Of Date],2)+1+(0) RETURN CALCULATE([Available Hours],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],S,S+6))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "d0bcf35d-fef4-58bb-af60-9394557fc726"
          },
          {
            "name": "Available Hours Next Week",
            "expression": "VAR S=[As Of Date]-WEEKDAY([As Of Date],2)+1+(7) RETURN CALCULATE([Available Hours],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],S,S+6))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "cad54c72-07e8-560b-9bea-22d82b01e5f1"
          },
          {
            "name": "Available Hours FY",
            "expression": "VAR A=[As Of Date] VAR FM=SELECTEDVALUE(Settings[FiscalStartMonth],1) VAR S=DATE(YEAR(A)-IF(MONTH(A)<FM,1,0),FM,1) RETURN CALCULATE([Available Hours],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],S,EDATE(S,12)-1))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "ff3327f2-2ff4-5eca-a67f-20481702626e"
          },
          {
            "name": "Dedicated Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FILTER(VALUES(DimEmployee[supportingCategory]),CONTAINSSTRING(DimEmployee[supportingCategory],\"Dedicated\"))))",
            "displayFolder": "04 Teams",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "48440455-bb3c-5ae9-8f44-41f698274a0e"
          },
          {
            "name": "Dedicated Strength",
            "expression": "CALCULATE([Active Team Strength],KEEPFILTERS(FILTER(VALUES(DimEmployee[supportingCategory]),CONTAINSSTRING(DimEmployee[supportingCategory],\"Dedicated\"))))",
            "displayFolder": "04 Teams",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "41022d11-39ea-5060-874a-8deebf48cd6d"
          },
          {
            "name": "Dedicated Utilization %",
            "expression": "CALCULATE([Monthly Utilization %],KEEPFILTERS(FILTER(VALUES(DimEmployee[supportingCategory]),CONTAINSSTRING(DimEmployee[supportingCategory],\"Dedicated\"))))",
            "displayFolder": "04 Teams",
            "formatString": "0.0%",
            "description": "",
            "lineageTag": "901f9a72-6e48-50a8-ba3f-60880ae1d75c"
          },
          {
            "name": "Dedicated FY Hours",
            "expression": "VAR E=[Last Completed Friday] VAR FM=SELECTEDVALUE(Settings[FiscalStartMonth],1) VAR S=DATE(YEAR(E)-IF(MONTH(E)<FM,1,0),FM,1) RETURN CALCULATE([Dedicated Hours],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],S,E))",
            "displayFolder": "04 Teams",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "05273bdf-dbfd-562b-bb27-4420847ee2bc"
          },
          {
            "name": "Flex Hours",
            "expression": "CALCULATE([Actual Hours],KEEPFILTERS(FILTER(VALUES(DimEmployee[supportingCategory]),CONTAINSSTRING(DimEmployee[supportingCategory],\"Flex\"))))",
            "displayFolder": "04 Teams",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "d691b76c-5f59-5abc-b7b2-a684b642811c"
          },
          {
            "name": "Flex Strength",
            "expression": "CALCULATE([Active Team Strength],KEEPFILTERS(FILTER(VALUES(DimEmployee[supportingCategory]),CONTAINSSTRING(DimEmployee[supportingCategory],\"Flex\"))))",
            "displayFolder": "04 Teams",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "27ebfa42-afc1-5990-9510-7811a9696dfe"
          },
          {
            "name": "Flex Utilization %",
            "expression": "CALCULATE([Monthly Utilization %],KEEPFILTERS(FILTER(VALUES(DimEmployee[supportingCategory]),CONTAINSSTRING(DimEmployee[supportingCategory],\"Flex\"))))",
            "displayFolder": "04 Teams",
            "formatString": "0.0%",
            "description": "",
            "lineageTag": "3d0898d8-4be3-5ebd-8efc-3917a73720d7"
          },
          {
            "name": "Flex FY Hours",
            "expression": "VAR E=[Last Completed Friday] VAR FM=SELECTEDVALUE(Settings[FiscalStartMonth],1) VAR S=DATE(YEAR(E)-IF(MONTH(E)<FM,1,0),FM,1) RETURN CALCULATE([Flex Hours],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],S,E))",
            "displayFolder": "04 Teams",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "a91c8343-49dc-5d6c-960d-a8a36d644a7d"
          },
          {
            "name": "Available Employee Equivalents",
            "expression": "IF(NOT ISBLANK([Monthly Utilization %]),DIVIDE(MAX(0,[Available Hours]-[Effective Hours]),SELECTEDVALUE(Settings[DailyHours],8)*[Working Days]))",
            "displayFolder": "04 Teams",
            "formatString": "#,##0.0",
            "description": "Unused hours converted to full-period employee equivalents; not a named cohort or staff assignment.",
            "lineageTag": "13a62a5a-0777-5073-a649-4366eaa92030"
          },
          {
            "name": "Projects Delivered",
            "expression": "CALCULATE(COUNTROWS(FILTER(DimProject,NOT ISBLANK(DimProject[deliveredDate]) && DimProject[deliveredDate] IN VALUES(DimDate[Date]))),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "05 Delivery",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "e5ae8e91-1078-52aa-b13a-1c006ba0dc72"
          },
          {
            "name": "Projects On Time",
            "expression": "CALCULATE(COUNTROWS(FILTER(FILTER(DimProject,NOT ISBLANK(DimProject[deliveredDate]) && DimProject[deliveredDate] IN VALUES(DimDate[Date])),NOT ISBLANK(DimProject[targetDate]) && DimProject[deliveredDate]<=DimProject[targetDate])),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "05 Delivery",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "2c0098d5-4052-5500-947b-a6b1db5f9819"
          },
          {
            "name": "Project On Time %",
            "expression": "VAR Known=CALCULATE(COUNTROWS(FILTER(FILTER(DimProject,NOT ISBLANK(DimProject[deliveredDate]) && DimProject[deliveredDate] IN VALUES(DimDate[Date])),NOT ISBLANK(DimProject[targetDate]))),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))) RETURN IF(Known=[Projects Delivered],DIVIDE([Projects On Time],Known))",
            "displayFolder": "05 Delivery",
            "formatString": "0.0%",
            "description": "",
            "lineageTag": "6d9f0dc3-a89b-5712-9d0c-7f5ce98579b3"
          },
          {
            "name": "Delivered Project Budget Hours",
            "expression": "VAR P=CALCULATETABLE(FILTER(DimProject,NOT ISBLANK(DimProject[deliveredDate]) && DimProject[deliveredDate] IN VALUES(DimDate[Date])),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))) RETURN IF(COUNTROWS(P)>0 && COUNTROWS(FILTER(P,ISBLANK(DimProject[budgetHours])))=0,SUMX(P,DimProject[budgetHours]))",
            "displayFolder": "05 Delivery",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "4b020ed2-e675-529e-ae9f-8e46bd55f055"
          },
          {
            "name": "Delivered Project Actual Hours",
            "expression": "VAR P=CALCULATETABLE(SELECTCOLUMNS(FILTER(DimProject,NOT ISBLANK(DimProject[deliveredDate]) && DimProject[deliveredDate] IN VALUES(DimDate[Date])),\"ID\",DimProject[id]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))) RETURN CALCULATE([Actual Hours],REMOVEFILTERS(DimDate),KEEPFILTERS(TREATAS(P,DimProject[id])))",
            "displayFolder": "05 Delivery",
            "formatString": "#,##0.0",
            "description": "Lifetime actual hours for the same delivered-project cohort as the budget, preventing partial-period vs lifetime-budget comparisons.",
            "lineageTag": "3afcb945-1573-5501-8e4c-523ae8ef458b"
          },
          {
            "name": "Effort Deviation %",
            "expression": "IF(NOT ISBLANK([Delivered Project Budget Hours]) && NOT ISCROSSFILTERED(DimEmployee) && NOT ISCROSSFILTERED(DimTask),DIVIDE([Delivered Project Actual Hours]-[Delivered Project Budget Hours],[Delivered Project Budget Hours]))",
            "displayFolder": "05 Delivery",
            "formatString": "0.0%",
            "description": "",
            "lineageTag": "687657cb-aa77-537b-a404-b52d21f5089e"
          },
          {
            "name": "Schedule Deviation Days",
            "expression": "CALCULATE(AVERAGEX(FILTER(FILTER(DimProject,NOT ISBLANK(DimProject[deliveredDate]) && DimProject[deliveredDate] IN VALUES(DimDate[Date])),NOT ISBLANK(DimProject[targetDate])),DATEDIFF(DimProject[targetDate],DimProject[deliveredDate],DAY)),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "05 Delivery",
            "formatString": "#,##0.0",
            "description": "Mean delivered minus planned target date in calendar days. Positive is late.",
            "lineageTag": "3a3f74dd-8e33-59bb-a804-72853fd1f042"
          },
          {
            "name": "Schedule Deviation %",
            "expression": "CALCULATE(AVERAGEX(FILTER(FILTER(DimProject,NOT ISBLANK(DimProject[deliveredDate]) && DimProject[deliveredDate] IN VALUES(DimDate[Date])),NOT ISBLANK(DimProject[startDate]) && DimProject[targetDate]>DimProject[startDate]),DIVIDE(DATEDIFF(DimProject[targetDate],DimProject[deliveredDate],DAY),DATEDIFF(DimProject[startDate],DimProject[targetDate],DAY))),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "05 Delivery",
            "formatString": "0.0%",
            "description": "Provisional normalized schedule deviation: days late/early divided by planned elapsed duration.",
            "lineageTag": "6b4e61a5-14cc-5ae2-a28a-d2ece67e39cc"
          },
          {
            "name": "Effort Alert Color",
            "expression": "IF(ISBLANK([Effort Deviation %]),\"#64748B\",IF(ABS([Effort Deviation %])>0.05,\"#DC2626\",\"#0F766E\"))",
            "displayFolder": "05 Delivery",
            "formatString": "",
            "description": "",
            "lineageTag": "9caaa3f9-e58b-5f9d-9122-bd74af395705"
          },
          {
            "name": "Schedule Alert Color",
            "expression": "IF(ISBLANK([Schedule Deviation %]),\"#64748B\",IF(ABS([Schedule Deviation %])>0.03,\"#DC2626\",\"#0F766E\"))",
            "displayFolder": "05 Delivery",
            "formatString": "",
            "description": "",
            "lineageTag": "1e39c6dc-1e7d-5544-a404-c75c3888f2b5"
          },
          {
            "name": "Detail Conflicts",
            "expression": "CALCULATE(COUNTROWS(FactWeeklyDetails),FactWeeklyDetails[detailConflict]=TRUE(),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "f6fc0779-9814-53d9-9b1f-f2e62f1f8a79"
          },
          {
            "name": "Weekly Fundamental Errors",
            "expression": "IF(COALESCE([Detail Conflicts],0)=0,CALCULATE(SUM(FactWeeklyDetails[fundamental_error_count]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "c0424c54-24e8-5a81-ab90-acaaf090a254"
          },
          {
            "name": "Improvement Log Count",
            "expression": "IF(COALESCE([Detail Conflicts],0)=0,CALCULATE(SUM(FactWeeklyDetails[improvement_count]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "d8531e99-51f4-58eb-9f49-6cb699ad8207"
          },
          {
            "name": "Designed",
            "expression": "IF(COALESCE([Detail Conflicts],0)=0,CALCULATE(SUM(FactWeeklyDetails[designed]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "de1ba278-a7dc-50dc-a976-e94fdf7094c1"
          },
          {
            "name": "Developed",
            "expression": "IF(COALESCE([Detail Conflicts],0)=0,CALCULATE(SUM(FactWeeklyDetails[developed]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "2103d70b-61a3-550a-b2f0-e015b9cfed56"
          },
          {
            "name": "Fundamental Errors",
            "expression": "VAR T=CALCULATETABLE(FactDeliverable,KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))),KEEPFILTERS(FactDeliverable[deliveredDate]<>BLANK())) RETURN IF(COUNTROWS(T)>0 && COUNTROWS(FILTER(T,ISBLANK(FactDeliverable[fundamentalErrors])))=0,SUMX(T,FactDeliverable[fundamentalErrors]))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "78a6072b-cd88-5ff1-aee9-b76a0568ac49"
          },
          {
            "name": "Information Errors",
            "expression": "VAR T=CALCULATETABLE(FactDeliverable,KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))),KEEPFILTERS(FactDeliverable[deliveredDate]<>BLANK())) RETURN IF(COUNTROWS(T)>0 && COUNTROWS(FILTER(T,ISBLANK(FactDeliverable[informationErrors])))=0,SUMX(T,FactDeliverable[informationErrors]))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "44d17bb2-0ac4-563e-80c8-8c745f3200ee"
          },
          {
            "name": "Readable Errors",
            "expression": "VAR T=CALCULATETABLE(FactDeliverable,KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))),KEEPFILTERS(FactDeliverable[deliveredDate]<>BLANK())) RETURN IF(COUNTROWS(T)>0 && COUNTROWS(FILTER(T,ISBLANK(FactDeliverable[readableErrors])))=0,SUMX(T,FactDeliverable[readableErrors]))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "bee7919b-d361-5784-a55c-668d579081e6"
          },
          {
            "name": "Deliverables",
            "expression": "CALCULATE(DISTINCTCOUNT(FactDeliverable[deliverableId]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))),KEEPFILTERS(FactDeliverable[deliveredDate]<>BLANK()))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "bc80e957-1424-52f2-a1d4-c33461e2fb63"
          },
          {
            "name": "Defect Density %",
            "expression": "DIVIDE([Fundamental Errors],[Deliverables])",
            "displayFolder": "08 Quality",
            "formatString": "0.0%",
            "description": "",
            "lineageTag": "a564dca1-39ec-59f0-a108-80724a8bb838"
          },
          {
            "name": "First Time Right %",
            "expression": "VAR T=CALCULATETABLE(FactDeliverable,KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))),KEEPFILTERS(FactDeliverable[deliveredDate]<>BLANK())) RETURN IF(COUNTROWS(T)>0 && COUNTROWS(FILTER(T,ISBLANK(FactDeliverable[hadRework])))=0,DIVIDE(COUNTROWS(FILTER(T,FactDeliverable[hadRework]=FALSE())),COUNTROWS(T)))",
            "displayFolder": "08 Quality",
            "formatString": "0.0%",
            "description": "",
            "lineageTag": "a33ec9c2-d5bf-52a2-b36b-03cfcc58422e"
          },
          {
            "name": "On Time Deliverables",
            "expression": "CALCULATE(COUNTROWS(FILTER(FactDeliverable,NOT ISBLANK(FactDeliverable[deliveredDate]) && NOT ISBLANK(FactDeliverable[plannedDate]) && FactDeliverable[deliveredDate]<=FactDeliverable[plannedDate])),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "08 Quality",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "d88d8eca-faab-5902-875c-3ff5f0a5e771"
          },
          {
            "name": "Defect Alert Color",
            "expression": "IF(ISBLANK([Defect Density %]),\"#64748B\",IF(ABS([Defect Density %]-SELECTEDVALUE(Settings[DefectTarget],0))>0.05,\"#DC2626\",\"#0F766E\"))",
            "displayFolder": "08 Quality",
            "formatString": "",
            "description": "",
            "lineageTag": "e4a6fd0f-bc4d-567f-be6d-070568cb051b"
          },
          {
            "name": "Products Touched",
            "expression": "VAR IDs=CALCULATETABLE(VALUES(FactTimesheet[projectId]),FactTimesheet[status] IN {\"submitted\",\"approved\"},KEEPFILTERS(FILTER(ALL(FactTimesheet[division]),NOT ISCROSSFILTERED(DimDivision) || FactTimesheet[division] IN VALUES(DimDivision[divisionName])))) RETURN CALCULATE(DISTINCTCOUNT(DimProject[product]),KEEPFILTERS(TREATAS(IDs,DimProject[id])),DimProject[product]<>BLANK())",
            "displayFolder": "06 Improvement",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "2c6520e9-e788-5457-9442-02860ad1f87c"
          },
          {
            "name": "Additive Manufacturing",
            "expression": "CALCULATE(DISTINCTCOUNT(FactImprovement[improvementId]),FactImprovement[isAdditiveManufacturing]=TRUE(),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "06 Improvement",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "ed37d873-59be-5306-bb19-31e9419b91d8"
          },
          {
            "name": "Improvement Initiatives",
            "expression": "CALCULATE(DISTINCTCOUNT(FactImprovement[improvementId]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "06 Improvement",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "75b2d88e-f916-5d94-847d-fe3a472a06d0"
          },
          {
            "name": "Open Positions",
            "expression": "VAR E=MAX(DimDate[Date]) VAR S=DATE(YEAR(E),MONTH(E),1) VAR T=CALCULATETABLE(FactStaffing,REMOVEFILTERS(DimDate),DimDate[Date]=S) RETURN IF(COUNTROWS(T)=COUNTROWS(VALUES(DimDivision[id])) && COUNTROWS(FILTER(T,ISBLANK(FactStaffing[openPositions])))=0,SUMX(T,FactStaffing[openPositions]))",
            "displayFolder": "07 Staffing",
            "formatString": "#,##0",
            "description": "Snapshot for last selected month. Blank if any selected division has no entry.",
            "lineageTag": "a3c3b1c5-a3f1-51fd-bfa3-e223acadeea4"
          },
          {
            "name": "New Joiners",
            "expression": "VAR Months=SELECTCOLUMNS(SUMMARIZE(DimDate,DimDate[YearMonth]),\"MonthStart\",CALCULATE(DATE(YEAR(MIN(DimDate[Date])),MONTH(MIN(DimDate[Date])),1))) VAR T=CALCULATETABLE(FactStaffing,REMOVEFILTERS(DimDate),TREATAS(Months,DimDate[Date])) RETURN IF(COUNTROWS(T)=COUNTROWS(Months)*COUNTROWS(VALUES(DimDivision[id])) && COUNTROWS(FILTER(T,ISBLANK(FactStaffing[newJoiners])))=0,SUMX(T,FactStaffing[newJoiners]))",
            "displayFolder": "07 Staffing",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "773e3f94-2d07-5a90-b41c-03a0fb2015b1"
          },
          {
            "name": "Hours Scheduled",
            "expression": "IF(NOT ISCROSSFILTERED(DimEmployee) && NOT ISCROSSFILTERED(DimTask),CALCULATE(SUM(FactPlan[scheduledHours]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "6e5002f6-ede5-5795-9a49-6b827e2b0d53"
          },
          {
            "name": "Remaining Forecast Hours",
            "expression": "IF(NOT ISCROSSFILTERED(DimEmployee) && NOT ISCROSSFILTERED(DimTask),CALCULATE(SUM(FactPlan[remainingForecastHours]),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName])))))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "5b001cb4-2fe0-52de-9d18-d2dffaadc437"
          },
          {
            "name": "Team Forecast Hours",
            "expression": "VAR A=[As Of Date] RETURN IF(NOT ISCROSSFILTERED(DimEmployee) && NOT ISCROSSFILTERED(DimTask),CALCULATE([Actual Hours],KEEPFILTERS(DimDate[Date]<A))+[Remaining Forecast Hours])",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "Past actuals plus future remaining budget. Past and future do not overlap.",
            "lineageTag": "dd7a6c7a-fe17-5869-8194-4668e4e3ccd2"
          },
          {
            "name": "Overdue Unscheduled Hours",
            "expression": "VAR A=[As Of Date] RETURN CALCULATE(SUMX(FILTER(DimProject,DimProject[projectStatus]=\"Inprogress\" && NOT ISBLANK(DimProject[targetDate]) && DimProject[targetDate]<A && NOT ISBLANK(DimProject[budgetHours])),MAX(0,DimProject[budgetHours]-CALCULATE([Actual Hours],REMOVEFILTERS(DimDate)))),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0.0",
            "description": "",
            "lineageTag": "3af7f285-60ab-59c1-ae10-cef5d55a3151"
          },
          {
            "name": "Projects Missing Plan Inputs",
            "expression": "CALCULATE(COUNTROWS(FILTER(DimProject,DimProject[projectStatus]=\"Inprogress\" && (ISBLANK(DimProject[startDate]) || ISBLANK(DimProject[targetDate]) || ISBLANK(DimProject[budgetHours]) || DimProject[targetDate]<DimProject[startDate]))),KEEPFILTERS(FILTER(ALL(DimProject[division]),NOT ISCROSSFILTERED(DimDivision) || DimProject[division] IN VALUES(DimDivision[divisionName]))))",
            "displayFolder": "03 Capacity",
            "formatString": "#,##0",
            "description": "",
            "lineageTag": "50e5c8c0-a5e7-5f70-a972-857efd0e8a1d"
          },
          {
            "name": "Report Status",
            "expression": "IF(ISBLANK([Last Refresh UTC]),\"API refresh required\",\"Refreshed \" & [Last Refresh UTC]) & \" \u2022 see Input readiness for missing source contracts\"",
            "displayFolder": "09 Metadata",
            "formatString": "",
            "description": "",
            "lineageTag": "5b8e757b-f003-5d90-aabc-a5d1a17eb3b9"
          },
          {
            "name": "Last Refresh UTC",
            "expression": "SELECTEDVALUE(Settings[RefreshUTC])",
            "displayFolder": "09 Metadata",
            "formatString": "",
            "description": "",
            "lineageTag": "8ee187a9-8ad9-557a-b306-b7a1860df90a"
          }
        ]
      }
    ],

// ═══════════════════════════════════════════════════════════════════════
// DAX Measures Library — GCC Timesheet Power BI Dashboard v1.1.0
// ═══════════════════════════════════════════════════════════════════════
// Usage: Create a measures table in Power BI Desktop:
//   Home → Enter Data → name it "_Measures" → Load
//   Then add each measure below to the _Measures table.
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────
// POPULATION & FACT BASELINES
// ─────────────────────────────────────────────────────────────

Total Entries =
COUNTROWS(FactTimesheet)

Total Hours =
SUM(FactTimesheet[hours])

Average Hours =
AVERAGE(FactTimesheet[hours])

Average Hours per Employee =
DIVIDE([Total Hours], [Active Employee Count], 0)

Average Hours per Entry =
DIVIDE([Total Hours], [Total Entries], 0)

Employee Count =
DISTINCTCOUNT(DimEmployee[employeeId])

Active Employee Count =
CALCULATE(
    DISTINCTCOUNT(DimEmployee[employeeId]),
    DimEmployee[isActive] = TRUE()
)

Project Count =
DISTINCTCOUNT(DimProject[projectCode])

Active Project Count =
CALCULATE(
    DISTINCTCOUNT(DimProject[projectCode]),
    DimProject[isActive] = TRUE()
)

Division Count =
DISTINCTCOUNT(DimDivision[divisionName])

Department Count =
DISTINCTCOUNT(DimDepartment[departmentName])

// ─────────────────────────────────────────────────────────────
// STATUS DISTRIBUTIONS (HOURS)
// ─────────────────────────────────────────────────────────────

Draft Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[status] = "draft"
)

Submitted Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[status] = "submitted"
)

Approved Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[status] = "approved"
)

Rejected Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[status] = "rejected"
)

Recalled Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[status] = "recalled"
)

Pending Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[status] IN {"draft", "submitted"}
)

// ─────────────────────────────────────────────────────────────
// STATUS DISTRIBUTIONS (ENTRIES)
// ─────────────────────────────────────────────────────────────

Draft Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] = "draft"
)

Submitted Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] = "submitted"
)

Approved Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] = "approved"
)

Rejected Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] = "rejected"
)

Pending Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] IN {"draft", "submitted"}
)

// ─────────────────────────────────────────────────────────────
// BILLABLE & NON-BILLABLE
// ─────────────────────────────────────────────────────────────

Billable Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[isBillable] = TRUE()
)

Non-Billable Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    FactTimesheet[isBillable] = FALSE()
)

Billable Percentage =
DIVIDE([Billable Hours], [Total Hours], 0)

// ─────────────────────────────────────────────────────────────
// COMPLIANCE & SUBMISSION RATES
// ─────────────────────────────────────────────────────────────

Submission Rate =
VAR SubmittedOrBeyond =
    CALCULATE(
        COUNTROWS(FactTimesheet),
        FactTimesheet[status] IN {"submitted", "approved", "rejected", "recalled"}
    )
RETURN
    DIVIDE(SubmittedOrBeyond, [Total Entries], 0)

Approval Rate =
VAR ApprovedOnly =
    CALCULATE(
        COUNTROWS(FactTimesheet),
        FactTimesheet[status] = "approved"
    )
VAR SubmittedOrBeyond =
    CALCULATE(
        COUNTROWS(FactTimesheet),
        FactTimesheet[status] IN {"submitted", "approved", "rejected", "recalled"}
    )
RETURN
    DIVIDE(ApprovedOnly, SubmittedOrBeyond, 0)

Rejection Rate =
VAR RejectedOnly =
    CALCULATE(
        COUNTROWS(FactTimesheet),
        FactTimesheet[status] = "rejected"
    )
VAR SubmittedOrBeyond =
    CALCULATE(
        COUNTROWS(FactTimesheet),
        FactTimesheet[status] IN {"submitted", "approved", "rejected", "recalled"}
    )
RETURN
    DIVIDE(RejectedOnly, SubmittedOrBeyond, 0)

// ─────────────────────────────────────────────────────────────
// WORKING DAYS / UTILIZATION
// ─────────────────────────────────────────────────────────────

Standard Daily Hours =
8

Working Days =
CALCULATE(
    DISTINCTCOUNT(DimDate[Date]),
    DimDate[IsWeekend] = FALSE(),
    DimDate[IsHoliday] = FALSE()
)

Expected Hours =
[Working Days] * [Standard Daily Hours]

Utilization Rate =
DIVIDE([Total Hours], [Expected Hours], 0)

Weekend Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    DimDate[IsWeekend] = TRUE()
)

Holiday Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    DimDate[IsHoliday] = TRUE()
)

Weekend Employees =
DISTINCTCOUNT(
    CALCULATE(
        FactTimesheet[employeeId],
        DimDate[IsWeekend] = TRUE()
    )
)

Holiday Employees =
DISTINCTCOUNT(
    CALCULATE(
        FactTimesheet[employeeId],
        DimDate[IsHoliday] = TRUE()
    )
)

// ─────────────────────────────────────────────────────────────
// TIME INTELLIGENCE
// ─────────────────────────────────────────────────────────────

Current Week Hours =
VAR CurrentDate = TODAY()
VAR WeekStart = CurrentDate - WEEKDAY(CurrentDate, 2) + 1
VAR WeekEnd = WeekStart + 6
RETURN
    CALCULATE(
        SUM(FactTimesheet[hours]),
        DimDate[Date] >= WeekStart && DimDate[Date] <= WeekEnd
    )

Previous Week Hours =
VAR CurrentDate = TODAY()
VAR PrevWeekStart = CurrentDate - WEEKDAY(CurrentDate, 2) + 1 - 7
VAR PrevWeekEnd = PrevWeekStart + 6
RETURN
    CALCULATE(
        SUM(FactTimesheet[hours]),
        DimDate[Date] >= PrevWeekStart && DimDate[Date] <= PrevWeekEnd
    )

Week over Week Change =
[Current Week Hours] - [Previous Week Hours]

Week over Week Change % =
DIVIDE(
    [Current Week Hours] - [Previous Week Hours],
    ABS([Previous Week Hours]) + 0.0000001,
    0
)

Current Month Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    DATESMTD(DimDate[Date])
)

Previous Month Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    PREVIOUSMONTH(DimDate[Date])
)

Month over Month Change =
[Current Month Hours] - [Previous Month Hours]

Month over Month Change % =
DIVIDE(
    [Current Month Hours] - [Previous Month Hours],
    ABS([Previous Month Hours]) + 0.0000001,
    0
)

YTD Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    DATESYTD(DimDate[Date])
)

Previous Year Hours =
CALCULATE(
    SUM(FactTimesheet[hours]),
    SAMEPERIODLASTYEAR(DimDate[Date])
)

Previous Year YTD =
CALCULATE(
    SUM(FactTimesheet[hours]),
    DATESYTD(SAMEPERIODLASTYEAR(DimDate[Date]))
)

YTD Variance =
[YTD Hours] - [Previous Year YTD]

YTD Variance % =
DIVIDE(
    [YTD Hours] - [Previous Year YTD],
    ABS([Previous Year YTD]) + 0.0000001,
    0
)

// ─────────────────────────────────────────────────────────────
// DAILY / WEEKLY / MONTHLY AVERAGES
// ─────────────────────────────────────────────────────────────

Average Daily Hours =
DIVIDE(
    [Total Hours],
    DISTINCTCOUNT(FactTimesheet[date]),
    0
)

Average Weekly Hours =
DIVIDE(
    [Total Hours],
    DISTINCTCOUNT(FactTimesheet[week]),
    0
)

Monthly Total =
[Total Hours]

Daily Average =
DIVIDE([Total Hours], DISTINCTCOUNT(FactTimesheet[date]), 0)

Weekly Average =
DIVIDE([Total Hours], DISTINCTCOUNT(FactTimesheet[week]), 0)

// ─────────────────────────────────────────────────────────────
// MISSING / DATA QUALITY SUPPORT
// ─────────────────────────────────────────────────────────────

Invalid Hours Count =
CALCULATE(
    COUNTROWS(FactTimesheet),
    OR(FactTimesheet[hours] < 0, FactTimesheet[hours] > 24)
)

Missing Employee IDs =
CALCULATE(
    COUNTROWS(FactTimesheet),
    ISBLANK(FactTimesheet[employeeId])
)

Invalid Status Count =
CALCULATE(
    COUNTROWS(FactTimesheet),
    NOT(FactTimesheet[status] IN {"draft", "submitted", "approved", "rejected", "recalled"})
)

// ─────────────────────────────────────────────────────────────
// LAST REFRESH METADATA (DISPLAY ONLY)
// ─────────────────────────────────────────────────────────────

Last Data Refresh =
NOW()

// ─────────────────────────────────────────────────────────────
// DOCUMENTATION-STYLE EXECUTIVE SUMMARY
// ─────────────────────────────────────────────────────────────

Active Employees =
[Active Employee Count]

Active Projects =
[Active Project Count]

Total Employees =
[Employee Count]

Total Divisions =
[Division Count]

Total Departments =
[Department Count]

Total Projects =
[Project Count]

Total Hours Managed =
[Total Hours]

Pending Approvals =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] IN {"draft", "submitted"}
)

// End of measures library

Week over Week Change Percentage =
DIVIDE(
    [Current Week Hours] - [Previous Week Hours],
    [Previous Week Hours],
    0
)


// ─────────────────────────────────────────────────────────────
// UTILIZATION
// ─────────────────────────────────────────────────────────────

Working Days in Period =
CALCULATE(
    COUNTROWS(DimDate),
    DimDate[IsWeekend] = FALSE(),
    DimDate[IsHoliday] = FALSE()
)

Expected Hours =
[Working Days in Period] * 8

Utilization Rate =
DIVIDE([Total Hours], [Expected Hours], 0)


// ─────────────────────────────────────────────────────────────
// ENTRY COUNTS
// ─────────────────────────────────────────────────────────────

Total Entries =
COUNTROWS(FactTimesheet)

Submitted Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] = "submitted"
)

Approved Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] = "approved"
)

Pending Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] IN {"draft", "submitted"}
)

Rejected Entries =
CALCULATE(
    COUNTROWS(FactTimesheet),
    FactTimesheet[status] = "rejected"
)


// ─────────────────────────────────────────────────────────────
// DASHBOARD VERSION
// ─────────────────────────────────────────────────────────────

Dashboard Version =
"GCC Timesheet Power BI v1.0.0"

Dashboard Info =
"Version 1.0.0 | API v1.x | " & FORMAT(NOW(), "YYYY-MM-DD HH:MM")

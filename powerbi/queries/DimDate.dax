// ═══════════════════════════════════════════════════════════════
// DimDate — Date Dimension Table for GCC Timesheet Power BI
// ═══════════════════════════════════════════════════════════════
// Usage: In Power BI Desktop → Home → New Table → paste this DAX
// Business week starts on Monday; weekend is Saturday or Sunday.
// ═══════════════════════════════════════════════════════════════

DimDate =
VAR StartDate = DATE(2020, 1, 1)
VAR EndDate = DATE(2035, 12, 31)
VAR HolidayDates = VALUES(DimHoliday[date])
VAR DateTable =
    ADDCOLUMNS(
        CALENDAR(StartDate, EndDate),
        "Year", YEAR([Date]),
        "QuarterNumber", INT(CEILING(MONTH([Date]) / 3, 1)),
        "Quarter", "Q" & FORMAT(INT(CEILING(MONTH([Date]) / 3, 1)), "0"),
        "Month", MONTH([Date]),
        "MonthName", FORMAT([Date], "MMMM"),
        "MonthShort", FORMAT([Date], "MMM"),
        "WeekNumber", WEEKNUM([Date], 2),
        "WeekStart", [Date] - WEEKDAY([Date], 2) + 1,
        "DayOfMonth", DAY([Date]),
        "DayOfWeek", WEEKDAY([Date], 2),
        "DayName", FORMAT([Date], "dddd"),
        "IsWeekend", IF(WEEKDAY([Date], 2) >= 6, TRUE(), FALSE()),
        "IsHoliday", IF(
            CALCULATE(
                COUNTROWS(HolidayDates),
                HolidayDates[date] = [Date]
            ) > 0,
            TRUE(),
            FALSE()
        ),
        "YearMonth", FORMAT([Date], "YYYY-MM"),
        "YearQuarter", FORMAT([Date], "YYYY") & " Q" & FORMAT(INT(CEILING(MONTH([Date]) / 3, 1)), "0"),
        "MonthYearLabel", FORMAT([Date], "MMM YYYY"),
        "WeekLabel", "W" & FORMAT(WEEKNUM([Date], 2), "00") & " " & FORMAT([Date], "YYYY")
    )
RETURN
    DateTable
